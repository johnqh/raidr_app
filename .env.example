# raidr app environment
VITE_APP_NAME=raidr
VITE_APP_DOMAIN=raidr.app
VITE_COMPANY_NAME=Sudobility
VITE_SUPPORT_EMAIL=support@raidr.app

# raidr_api base URL (development: http://localhost:3000)
VITE_API_URL=https://api.raidr.app

# Firebase: Analytics only (Auth is not used). From Firebase Console >
# Project Settings > General > Your apps. Analytics needs API key, project id,
# app id and measurement id; the rest are standard web config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
